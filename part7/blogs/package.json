{
  "name": "part7-blogs",
  "private": true,
  "scripts": {
    "dev": "sh -c 'trap \"kill 0\" EXIT; npm --prefix backend run dev & npm --prefix frontend run dev & wait'",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend run start",
    "build": "npm --prefix frontend run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test:frontend:e2e": "npm --prefix frontend run test:e2e",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "npm run install:backend && npm run install:frontend",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "^0.45.0"
  }
}
